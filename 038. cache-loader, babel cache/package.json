{
  "name": "webpack-cache-demo",
  "version": "1.0.0",
  "description": "纯 webpack 缓存示例：cache-loader + babel-loader cacheDirectory + webpack5 filesystem cache",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:cold": "rimraf dist node_modules/.cache && webpack --mode production"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "babel-loader": "^9.1.3",
    "cache-loader": "^4.1.0",
    "html-webpack-plugin": "^5.6.0",
    "rimraf": "^5.0.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  }
}
