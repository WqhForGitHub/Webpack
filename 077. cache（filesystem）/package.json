{
  "name": "webpack-cache-filesystem",
  "version": "1.0.0",
  "description": "纯 webpack 演示 cache.type = 'filesystem'",
  "private": true,
  "scripts": {
    "build": "webpack",
    "build:dev": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "clean": "node -e \"require('fs').rmSync('.webpack-cache', { recursive: true, force: true }); require('fs').rmSync('dist', { recursive: true, force: true });\""
  },
  "devDependencies": {
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0"
  }
}
