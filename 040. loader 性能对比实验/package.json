{
  "name": "webpack-loader-perf-demo",
  "version": "1.0.0",
  "description": "纯 webpack loader 性能对比实验：basic / cache / thread / cache+thread",
  "private": true,
  "scripts": {
    "gen": "node scripts/gen.js",
    "clean": "rimraf dist node_modules/.cache",
    "build:basic": "webpack --config configs/webpack.basic.js",
    "build:cache": "webpack --config configs/webpack.cache.js",
    "build:thread": "webpack --config configs/webpack.thread.js",
    "build:thread-cache": "webpack --config configs/webpack.thread-cache.js",
    "bench": "node scripts/bench.js"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "babel-loader": "^9.1.3",
    "rimraf": "^5.0.5",
    "thread-loader": "^4.0.4",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
