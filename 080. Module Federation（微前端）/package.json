{
  "name": "module-federation-demo",
  "version": "1.0.0",
  "description": "纯 webpack 5 演示 Module Federation（微前端）—— host + remote",
  "private": true,
  "scripts": {
    "start:remote": "webpack serve --config remote/webpack.config.js",
    "start:host": "webpack serve --config host/webpack.config.js",
    "build:remote": "webpack --config remote/webpack.config.js",
    "build:host": "webpack --config host/webpack.config.js"
  },
  "devDependencies": {
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "html-webpack-plugin": "^5.6.0"
  }
}
