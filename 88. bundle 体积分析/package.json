{
  "name": "webpack-bundle-size-analysis",
  "version": "1.0.0",
  "description": "纯 webpack bundle 体积分析 demo（stats + bundle-analyzer）",
  "private": true,
  "scripts": {
    "build": "webpack",
    "build:stats": "webpack --json > stats.json",
    "analyze": "webpack --env analyze",
    "analyze:json": "webpack-bundle-analyzer stats.json dist"
  },
  "devDependencies": {
    "lodash": "^4.17.21",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4"
  }
}
