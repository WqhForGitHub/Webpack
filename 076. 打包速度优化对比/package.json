{
  "name": "webpack-build-speed-compare",
  "version": "1.0.0",
  "description": "纯 webpack 对比不同优化策略的打包速度",
  "private": true,
  "scripts": {
    "build:baseline": "webpack --env scenario=baseline",
    "build:cache": "webpack --env scenario=cache",
    "build:exclude": "webpack --env scenario=exclude",
    "build:thread": "webpack --env scenario=thread",
    "build:all": "npm run build:baseline && npm run build:cache && npm run build:exclude && npm run build:thread"
  },
  "devDependencies": {
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "thread-loader": "^4.0.2",
    "speed-measure-webpack-plugin": "^1.5.0"
  }
}
