{
  "name": "webpack-sideeffects",
  "version": "1.0.0",
  "description": "纯 webpack 演示 sideEffects 配置（package.json 字段）",
  "private": true,
  "sideEffects": [
    "./src/polyfill.js",
    "*.css"
  ],
  "scripts": {
    "build": "webpack",
    "build:dev": "webpack --mode development",
    "build:prod": "webpack --mode production"
  },
  "devDependencies": {
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.0"
  }
}
